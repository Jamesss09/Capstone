# Copy to a protected file outside version control and pass it with:
# docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
APP_KEY=
APP_URL=https://api.example.edu
CORS_ALLOWED_ORIGINS=https://admin.example.edu
TRUSTED_PROXIES=*

MYSQL_DATABASE=code_nexus
MYSQL_USER=nexus
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
INITIAL_STAFF_PASSWORD=replace-with-a-different-long-random-password

OMR_OPENCV_THREADS=8
OMR_TORCH_THREADS=4
