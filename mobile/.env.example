# Physical Android phone: use this computer's LAN IPv4 address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# Android Studio emulator alternative:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Expo Build reads this value from its preview/production environment. Configure
# the permanent HTTPS API URL before building; do not use a trycloudflare URL:
# npx eas-cli@latest env:set --name EXPO_PUBLIC_API_URL --value https://api.example.edu/api --environment production --visibility plaintext
