APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=omr
DB_QUEUE_RETRY_AFTER=240

# Private Python OMR service (Laravel calls this; mobile clients do not).
OMR_SERVICE_URL=http://omr:5005
OMR_CONNECT_TIMEOUT=5
OMR_REQUEST_TIMEOUT=180

# Delete successfully processed source images after one year. Structured
# answers, results, confidence values, and diagnostics are retained.
ANSWER_SHEET_RETENTION_DAYS=365

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- API auth: short-lived access token + httpOnly refresh cookie ---
# Access token (sent as a Bearer header, held in memory) � minutes.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token (httpOnly cookie) � days. Also the "Remember me" lifetime.
REFRESH_TOKEN_TTL_DAYS=7
# Explicit origins are mandatory once the refresh cookie uses credentials
# (CORS forbids "*" with supports_credentials). Hostnames must match the SPA so
# the SameSite=lax cookie is still sent.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required when running DatabaseSeeder in production. Local development falls
# back to the documented demo credentials; production never does.
INITIAL_ADMIN_PASSWORD=
INITIAL_STAFF_PASSWORD=
